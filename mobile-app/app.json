{
  "expo": {
    "name": "GeoAttend",
    "slug": "geoattend",
    "version": "1.0.0",
    "scheme": "com.geoattend.app",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a5276"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a5276"
      },
      "package": "com.geoattend.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GeoAttend to use your location for attendance check-in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GeoAttend to access your camera for QR code scanning."
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.725872424154-gv0c4blr061adus9iuaf8htc09pjk5l8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4a453cbb-ffe6-48dc-9c41-a1ca2c3866b8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4a453cbb-ffe6-48dc-9c41-a1ca2c3866b8"
    },
    "ios": {}
  }
}
