{
  "expo": {
    "name": "GeoAttend",
    "slug": "geoattend",
    "version": "1.0.0",
    "scheme": "com.geoattend.app",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a5276"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a5276"
      },
      "package": "com.geoattend.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GeoAttend to use your location for attendance check-in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GeoAttend to access your camera for QR code scanning."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "6835079a-9aa4-49f4-9ac0-1cff2f2a5af3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6835079a-9aa4-49f4-9ac0-1cff2f2a5af3"
    },
    "ios": {}
  }
}
